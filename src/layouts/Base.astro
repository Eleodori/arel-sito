---
import '../styles/site.css';
import { SITE, LIVE } from '../lib/site.js';
import { LANGS, OG_LOCALE, DEFAULT_LANG, langPath } from '../i18n/index.js';

interface Props {
  title: string;
  description: string;
  lang?: string;            // lingua della pagina (it di default)
  sub?: string;             // percorso senza prefisso di lingua: '' per la home, 'privacy/' per la privacy
  path?: string;            // solo per pagine non tradotte (es. 404)
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonld?: object;
}
const { title, description, lang = DEFAULT_LANG, sub, path, ogTitle = title, ogDescription = description, ogImage = '/og/home.png', noindex = false, jsonld } = Astro.props;
const translated = sub !== undefined;
const canonical = new URL(translated ? langPath(lang, sub) : (path || '/'), SITE).href;
const alternates = translated ? LANGS.map((l) => ({ l, href: new URL(langPath(l, sub), SITE).href })) : [];
const robots = LIVE && !noindex ? 'index, follow' : 'noindex, nofollow';
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={robots}>
{!noindex && <link rel="canonical" href={canonical}>}
{!noindex && alternates.map(({ l, href }) => <link rel="alternate" hreflang={l} href={href}>)}
{!noindex && translated && <link rel="alternate" hreflang="x-default" href={new URL(langPath(DEFAULT_LANG, sub), SITE).href}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Arel Group">
<meta property="og:locale" content={OG_LOCALE[lang]}>
{translated && LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]}>)}
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(ogImage, SITE).href}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0A1226">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preload" href="/assets/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
{jsonld && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonld)} />}
</head>
<body>
<slot />
</body>
</html>
