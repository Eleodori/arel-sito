---
// Pagine servizio in italiano: /servizi/<slug>/ (contenuti in src/data/servizi.js)
import Service from '../../components/Service.astro';
import { SERVICES } from '../../data/services.js';
export function getStaticPaths() {
  return SERVICES.it.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
---
<Service s={s} lang="it" />
