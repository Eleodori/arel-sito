---
// Selettore lingua: link alla stessa pagina nelle 4 lingue. Nessun redirect automatico.
// <details> nativo: funziona senza JavaScript, si apre con tastiera e lettori di schermo.
import { LANGS, LANG_NAMES, I18N, langPath } from '../i18n/index.js';
interface Props { lang: string; sub?: string }
const { lang, sub = '' } = Astro.props;
---
<details class="langsw">
  <summary aria-label={`${I18N[lang].lang_label}: ${LANG_NAMES[lang]}`}><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9s1.3-6.4 3.8-9z"/></svg><span>{lang.toUpperCase()}</span></summary>
  <ul>
    {LANGS.map((l) => (
      <li><a href={langPath(l, sub)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}><b>{l.toUpperCase()}</b>{LANG_NAMES[l]}</a></li>
    ))}
  </ul>
</details>
