# Variabili d'ambiente del Lab AI.
# Su Netlify: Site configuration → Environment variables (NON mettere mai la chiave nel codice).
# In locale (netlify dev): copia questo file in .env e compila.

# Obbligatoria: chiave API di Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Obbligatoria: stringa casuale lunga, usata per anonimizzare gli IP nei limiti
IP_SALT=

# Domini da cui il Lab AI accetta richieste (separati da virgola). Le anteprime *.netlify.app sono già ammesse.
ALLOWED_ORIGINS=https://www.DOMINIO.it,https://DOMINIO.it

# Facoltative (valori predefiniti tra parentesi)
# LAB_ENABLED=true                     # false = Lab in modalità demo, zero chiamate
# LAB_MODEL_QUICK=claude-haiku-4-5-20251001   # domande
# LAB_MODEL_MAIN=claude-sonnet-5              # blueprint
# LAB_LIMIT_QUESTIONS_PER_IP=8         # analisi per visitatore al giorno
# LAB_LIMIT_BLUEPRINTS_PER_IP=3        # blueprint per visitatore al giorno
# LAB_LIMIT_GLOBAL_PER_DAY=150         # chiamate totali al giorno per tutto il sito
# LAB_MIN_GAP_SECONDS=6                # pausa minima tra due richieste dello stesso visitatore
# ALLOW_NETLIFY_PREVIEWS=true
# ALLOW_LOCALHOST=false                # true solo per netlify dev in locale
